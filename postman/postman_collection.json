            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dupont\",\n  \"firstname\": \"Sami\",\n  \"age\": 25,\n  \"cin\": \"01234567\",\n  \"job\": \"Développeur\",\n  \"path\": \"cvs/sami.pdf\",\n  \"skillIds\": [\n    1,\n    2\n  ]\n}",
              "options": {
