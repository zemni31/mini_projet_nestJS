{
  "info": {
    "name": "TP2 NestJS - Cvs, Skills, Auth",
    "description": "Lot 5 : jeu de tests de toutes les routes. Lancer `npm run seed:cvs` puis `npm run start:dev` avant d'exécuter la collection (les skills 1, 2, 3 du seed sont utilisées).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Auth (inscription)",
      "item": [
        {
          "name": "Inscription OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/inscription",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "inscription"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"email\": \"{{username}}@test.tn\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// username unique à chaque exécution (max 20 caractères)",
                  "pm.collectionVariables.set(\"username\", \"test\" + Date.now().toString().slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Inscription : statut 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Le username renvoyé est celui envoyé\", () => pm.expect(body.username).to.eql(pm.collectionVariables.get(\"username\")));",
                  "pm.test(\"Le mot de passe n'est jamais renvoyé\", () => pm.expect(body).to.not.have.property(\"password\"));",
                  "pm.test(\"Le rôle par défaut est user\", () => pm.expect(body.role).to.eql(\"user\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription username déjà pris (409)",
