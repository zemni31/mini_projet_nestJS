                "exec": [
                  "pm.test(\"Création : statut 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Le CIN garde son 0 initial\", () => pm.expect(body.cin).to.eql(\"01234567\"));",
                  "pm.test(\"Le cv a ses 2 skills (relation N-N)\", () => pm.expect(body.skills).to.have.lengthOf(2));",
                  "pm.collectionVariables.set(\"cvId\", body.id);"
                ]
